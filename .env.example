# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it's excluded via .gitignore.

# LLM provider API key (e.g. Anthropic, OpenAI)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=claude-sonnet-4-6

# Web search API key — get a free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: max follow-up searches per contested claim before giving up
MAX_ADAPT_RETRIES=2
